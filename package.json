    "express": "^5.3.0",
    "express-handlebars": "^9.0.6",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
