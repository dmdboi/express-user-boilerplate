<div class="mx-auto max-w-2xl">
    <div class="card">
        {{#if error.status}}
        <p class="text-sm font-semibold uppercase tracking-widest text-red-600">Error {{error.status}}</p>
        {{/if}}
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">{{message}}</h1>
        {{#if error.stack}}
        <pre class="mt-6 overflow-x-auto whitespace-pre-wrap break-words rounded-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100">{{error.stack}}</pre>
        {{/if}}
    </div>
</div>
