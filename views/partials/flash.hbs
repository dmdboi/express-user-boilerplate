{{#if messages.error}}
    <div class="mb-6 space-y-3">
        {{#each messages.error}}
        <div data-alert
            class="flex items-start justify-between gap-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 font-semibold text-red-800"
            role="alert">
            <span>{{this}}</span>
            <button type="button" data-dismiss-alert aria-label="Close"
                class="text-xl font-normal leading-none text-red-500 transition hover:text-red-700">&times;</button>
        </div>
        {{/each}}
    </div>
{{/if}}

{{#if messages.success}}
    <div class="mb-6 space-y-3">
        {{#each messages.success}}
        <div data-alert
            class="flex items-start justify-between gap-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 font-semibold text-emerald-800"
            role="alert">
            <span>{{this}}</span>
            <button type="button" data-dismiss-alert aria-label="Close"
                class="text-xl font-normal leading-none text-emerald-500 transition hover:text-emerald-700">&times;</button>
        </div>
        {{/each}}
    </div>
{{/if}}
