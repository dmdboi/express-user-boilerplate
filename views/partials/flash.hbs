{{#if messages}}
    {{#each messages.error}}
        <div class="alert alert-danger fw-bold text-center mx-auto w-50 alert-dismissible fade show" role="alert">
            {{this}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/each}}

    {{#each messages.success}}
        <div class="alert alert-success fw-bold text-center mx-auto w-50 alert-dismissible fade show" role="alert">
            {{this}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/each}}
{{/if}}
